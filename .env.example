APP_ENV=development
LOG_LEVEL=INFO
# 本地文件日志。Docker 会分别保存 app.log 和 worker.log 到 runtime_logs/。
LOG_FILE=runtime_logs/news-agent.log
# LangSmith 默认关闭；填写 API Key 并把开关改为 true 后才会向 LangSmith 上传追踪输入/输出。
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=cs-news-agent
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_WORKSPACE_ID=
DATABASE_URL=postgresql+psycopg://news_agent:change-me@localhost:5432/news_agent
POSTGRES_DB=news_agent
POSTGRES_USER=news_agent
POSTGRES_PASSWORD=change-me

# OpenAI-compatible LLM. It is disabled unless LLM_ENABLED is explicitly true.
LLM_ENABLED=false
# 默认兜底配置。任务项留空时回退至这里；不要在日志、代码或版本库中保存真实密钥。
OPENAI_BASE_URL=
OPENAI_API_KEY=
LLM_MODEL=

# 会话与意图理解
CONVERSATION_LLM_MODEL=
CONVERSATION_OPENAI_BASE_URL=
CONVERSATION_OPENAI_API_KEY=

# 正文生成与自动改稿
CONTENT_LLM_MODEL=
CONTENT_OPENAI_BASE_URL=
CONTENT_OPENAI_API_KEY=

# 自动审核
REVIEW_LLM_MODEL=
REVIEW_OPENAI_BASE_URL=
REVIEW_OPENAI_API_KEY=

# 插图位置规划
ILLUSTRATION_PLANNER_LLM_MODEL=
ILLUSTRATION_PLANNER_OPENAI_BASE_URL=
ILLUSTRATION_PLANNER_OPENAI_API_KEY=

# 结构化输出模式：tool=强制调用结构化工具；json=只要求 JSON 文本并由本地 Pydantic 校验。
# 思考模式模型会拒绝 tool_choice=required（HTTP 400），此时把对应任务设为 json。
# 留空时回退 LLM_STRUCTURED_OUTPUT_MODE；校验失败会明确报错，不会降级生成替代内容。
LLM_STRUCTURED_OUTPUT_MODE=tool
CONVERSATION_STRUCTURED_OUTPUT_MODE=
CONTENT_STRUCTURED_OUTPUT_MODE=
REVIEW_STRUCTURED_OUTPUT_MODE=
ENHANCED_GENERATION_ENABLED=false
LLM_FAST_MODEL=
LLM_REASONING_MODEL=
# Exa remote MCP. Set EXA_MCP_ENABLED=true only after filling an API Key for stable quota.
# The hosted server also supports a limited anonymous quota, but production should use a key.
EXA_MCP_ENABLED=false
EXA_MCP_URL=https://mcp.exa.ai/mcp?tools=web_search_exa,web_fetch_exa
EXA_API_KEY=
EXA_SEARCH_MAX_QUERIES=2
EXA_SEARCH_MAX_RESULTS=5
EXA_SEARCH_RESULT_MAX_CHARS=6000
DEEP_AGENT_ENABLED=true
AGENT_SCRIPT_TIMEOUT_SECONDS=15

# Private MinIO storage for text chat attachments.
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false
MINIO_BUCKET=chat-attachments
ATTACHMENT_DOWNLOAD_SECRET=change-me-before-production
ATTACHMENT_LINK_TTL_SECONDS=900
ATTACHMENT_MAX_BYTES=2097152
APP_BASE_URL=http://127.0.0.1:8000

ARXIV_CATEGORIES=cs.AI,cs.CL,cs.LG
RSS_FEEDS=https://github.blog/changelog/feed/
COLLECT_LIMIT=25
REQUEST_TIMEOUT_SECONDS=20
# 普通会话在后台执行的总时限；超时会保留消息并显示可重试状态。
CONVERSATION_AGENT_TIMEOUT_SECONDS=45
# 正文生成、自动改稿、自动审核与配图规划共用的长文模型时限；较长 README 和结构化输出可等待最多 10 分钟。
CONTENT_LLM_TIMEOUT_SECONDS=600
# 长文请求由队列和用户重试控制，避免 SDK 在单个任务内重复等待。
CONTENT_LLM_MAX_RETRIES=0
SOURCE_RESPONSE_MAX_BYTES=1000000
SOURCE_CONTENT_MAX_CHARS=500000
LLM_EVIDENCE_MAX_CHARS=12000
# 正文必须至少 1200 字符；服务端也会阻止旧配置放宽到该下限以下。
DRAFT_BODY_MIN_CHARS=1200
DRAFT_BODY_MAX_CHARS=3200
# 自动审核评分达到该阈值且不存在 critical 级事实/来源问题时通过。
AUTO_REVIEW_PASS_SCORE=85

# WeChat Official Account local Skill credentials. Keep this template empty.
# AppSecret never enters logs or source code; the local Tool calls the official REST API directly.
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_API_TIMEOUT_SECONDS=45

# 仅用于 app/worker 访问外部资讯来源。Docker Desktop 请使用 host.docker.internal，
# 不要填写宿主机回环地址 127.0.0.1；生产环境应改为可访问的代理地址或留空。
OUTBOUND_HTTP_PROXY=http://host.docker.internal:7895
OUTBOUND_HTTPS_PROXY=http://host.docker.internal:7895
OUTBOUND_ALL_PROXY=http://host.docker.internal:7895
OUTBOUND_NO_PROXY=localhost,127.0.0.1,postgres,redis,minio,app,worker
# 可选：本地 TLS 拦截代理根证书在容器中的只读路径；证书仅放入 .local-certs/，不会提交。
LOCAL_PROXY_CA_FILE=/opt/news-agent-local-ca/steamtools-root-ca.crt
SOURCE_STALE_AFTER_MINUTES=120
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173
# 微信官方接口由本地 Skill 显式直连（不继承 OUTBOUND_* 代理）；无需 MCP/SSE 或额外代理变量。

# AI 图片生成。保持关闭并留空，只有用户明确请求生成插图时才会调用。
IMAGE_GENERATION_ENABLED=false
IMAGE_GENERATION_PROVIDER=agnes
IMAGE_GENERATION_BASE_URL=https://apihub.agnes-ai.com
IMAGE_GENERATION_API_KEY=
IMAGE_GENERATION_MODEL=agnes-image-2.5-flash
# Agnes Image 2.5 Flash 推荐尺寸档位 + 宽高比；4:3 适合公众号封面和正文插图。
IMAGE_GENERATION_SIZE=1K
IMAGE_GENERATION_RATIO=4:3
IMAGE_GENERATION_TIMEOUT_SECONDS=900
# 采集/改稿后台任务上限 15 分钟；每张图片任务上限 20 分钟。
COLLECTION_JOB_TIMEOUT_SECONDS=900
IMAGE_GENERATION_JOB_TIMEOUT_SECONDS=1200

# 自动审核通过后的终点是“创建公众号草稿并进入去重库”，绝不提交发表。
# 配置并验证图片服务、公众号服务后，再显式改为 true。
AUTO_WECHAT_DRAFT_ENABLED=false
